# Copy to .env and adjust. Never commit .env.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wallet_agent
# Dedicated roles, one per schema. Each service connects only with its own.
WALLET_DB_PASSWORD=change-me-wallet
AGENT_DB_PASSWORD=change-me-agent

# --- Users (idp credentials; user ids are also used by wallet-api seed data) -
USER1_USERNAME=alice
USER1_PASSWORD=alice-password
USER1_ID=11111111-1111-1111-1111-111111111111
USER2_USERNAME=bob
USER2_PASSWORD=bob-password
USER2_ID=22222222-2222-2222-2222-222222222222

# --- JWT ------------------------------------------------------------------
# Issuer and audience are set by idp and enforced by wallet-api and agent-service.
JWT_ISSUER=wallet-idp
JWT_AUDIENCE=wallet-api

# --- LLM (agent-service) --------------------------------------------------
# Any provider supported by langchain's init_chat_model. To use Anthropic set
# LLM_PROVIDER=anthropic, LLM_MODEL=<model id> and ANTHROPIC_API_KEY.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.1-flash-lite
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# --- LangSmith tracing (optional) ------------------------------------------
# Leave LANGSMITH_TRACING=false (or unset) to run without tracing. When enabled,
# traces contain conversation content and tool results, but never the user's token.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=wallet-agent
